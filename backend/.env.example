# These variables are provided to every Lambda function by CDK
# (see infrastructure/lib/api-stack.ts, auth-stack.ts) — you do not need to
# create a .env file to run the deployed backend. This file exists so you
# can see, at a glance, every backend configuration value the app depends
# on, and so you can export the same variables locally if you want to unit
# test a Lambda handler directly with `ts-node` outside of CDK/SAM.

AWS_REGION=ap-south-1

# DynamoDB table names (created by infrastructure/lib/database-stack.ts)
USER_TABLE_NAME=sangameshwara-dev-users
PRODUCT_TABLE_NAME=sangameshwara-dev-products
CATEGORY_TABLE_NAME=sangameshwara-dev-categories
CART_TABLE_NAME=sangameshwara-dev-carts
ORDER_TABLE_NAME=sangameshwara-dev-orders

# S3 bucket for product/category images (created by storage-stack.ts)
PRODUCT_BUCKET_NAME=sangameshwara-dev-product-images-<account-id>

# Admin's WhatsApp number that customer orders are addressed to.
# E.164 format, digits only after the +. Never commit a real number to a
# public repository if the number should stay private — treat it as
# configuration, not a secret, but still be mindful of exposure.
ADMIN_WHATSAPP_NUMBER=+919502003898

# CORS: set this to your deployed frontend's exact origin in production
# (e.g. https://d123456abcdef.cloudfront.net or https://www.yourdomain.in).
# Using "*" is convenient for local development only.
CORS_ALLOWED_ORIGIN=*

# Optional: delivery fee rules used by backend/src/common/order-utils.ts
DELIVERY_FEE=30
FREE_DELIVERY_THRESHOLD=500

STORE_NAME=Sangameshwara Kiranam & General Store
