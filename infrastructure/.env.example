# Deployment configuration for `cdk deploy` / `cdk synth`, read via CDK
# context or these environment variables (see infrastructure/lib/config.ts).
# None of these are secrets — they configure WHERE and for WHOM the stacks
# deploy, not credentials. AWS credentials themselves come from your normal
# AWS CLI configuration (`aws configure` / SSO / environment), never from
# this file.

# "dev" or "prod" — controls removal policies (dev resources are destroyed
# on stack deletion, prod resources are retained) and resource naming.
ENV_NAME=dev

AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1

# Store's WhatsApp number that customer orders are sent to, E.164 format.
ADMIN_WHATSAPP_NUMBER=+919502003898

# Optional custom domain + existing ACM certificate (must be in us-east-1
# for CloudFront). Leave both blank to use the default CloudFront domain.
DOMAIN_NAME=
CERTIFICATE_ARN=

# Exact origin of the deployed frontend, used for the backend's CORS policy.
# Update this once you know your CloudFront domain or custom domain.
CORS_ALLOWED_ORIGIN=*

# Optional CI/CD: only needed if you want infrastructure/lib/pipeline-stack.ts
# to actually provision a CodePipeline. Requires a one-time manual step to
# create and authorize a CodeStar Connection to GitHub (see README).
GITHUB_CONNECTION_ARN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
